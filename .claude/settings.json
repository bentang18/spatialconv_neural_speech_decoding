{
  "permissions": {
    "allow": [
      "mcp__exa__web_search_exa",
      "mcp__exa__web_search_advanced_exa",
      "mcp__arxiv__arxiv_search_papers",
      "mcp__arxiv__arxiv_get_paper"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/paper_guard.py"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check_lock_drift.py"
          }
        ]
      }
    ]
  }
}
