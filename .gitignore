# Data directories (large BIDS datasets + patient electrode data).
# IMPORTANT: `/data/` is anchored to the repo root so it does NOT match
# `src/speech_decoding/data/` or `src/speech_decoding/archive/legacy/data/`.
BIDS_1.0_*/
/data/
*.fif
*.edf
*.mat
*.pkl
*.h5
*.pt

# Machine-specific config
configs/paths.yaml

# Results
results/

# Past papers (large PDF library, kept locally)
pastwork/

# Auto-generated sbatch wrappers from scripts/ablation/submit.py
scripts/v14_core/_gen/

# Local submission log (DCC job ids + specs)
.ablation_submissions.jsonl

# Per-fold DCC training outputs (canonical record is v14_ablation_log.csv)
docs/experiments/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/

# Environment
.venv/
*.env

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Docs (PDFs generated from LaTeX)
docs/*.pdf

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz

# Claude Code worktrees (transient agent worktrees)
.claude/worktrees/
