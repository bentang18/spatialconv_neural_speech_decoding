reports/wandb.md
**/wandb_key*
*.secret

# DeltaAI/NCSA launch glue — holds NCSA identity (username, account, host, paths).
# Local-only, same policy as the gitignored docs/references/deltaai_setup.md.
scripts/deltaai/

# P3 alignment "become one with the data" viz (large mp4/npz — local-only deliverable)
p3_alignment_viz/

# Local-only media / checkpoint artifacts (large binaries — same policy as p3 viz).
audio/
movies/
movies_proxy/
checkpoints/

# Internal audit/handoff reports — keep OFF the public repo (public-main policy).
# Point-in-time audit artifacts live locally only; never publish to public main.
reports/

