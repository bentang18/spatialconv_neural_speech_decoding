#!/usr/bin/env bash
# Sync local branch to DCC, then run a submitter remotely.
# Usage: scripts/dcc/dispatch <submitter-relpath> [args...]
#
# Examples:
#   scripts/dcc/dispatch scripts/neuroprobe/submit_tier_c_cross_subject.py \
#       --l1-winner-norm train_set_fixed --l2-winner-ref bipolar \
#       --l2-winner-view stft_abs --skip-baseline
#
#   scripts/dcc/dispatch scripts/neuroprobe/audit_stimulus_overlap_cross_session.py \
#       --mode per-task --out-dir reports/neuroprobe_stage0_v0x_per_task_2026_05_10
#
# Submitter path is relative to repo root. The remote runs it via .venv/bin/python.

set -euo pipefail

DCC_HOST="${DCC_HOST:-ht203@dcc-login.oit.duke.edu}"
DCC_REPO="${DCC_REPO:-/work/ht203/repo/speech}"
# DCC non-interactive shells do NOT source ~/.bashrc, so the canonical
# v14 env vars (set there for interactive sessions) need to be injected
# here. Override per-invocation if needed.
DCC_ROOT_BT="${DCC_ROOT_BT:-/work/ht203/data/braintreebank}"
DCC_EXCA_CACHE="${DCC_EXCA_CACHE:-/hpc/group/coganlab/ht203/cache_neuroai}"

if [[ $# -lt 1 ]]; then
  echo "usage: scripts/dcc/dispatch <submitter-relpath> [args...]" >&2
  exit 2
fi

submitter="$1"; shift
script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(git rev-parse --show-toplevel)"

# SCAFFOLD-07 / B18 closure-gate: run the must_pass_before_dispatch test
# suite locally before syncing. Aborts the dispatch on any failure so the DCC
# clone never receives an inconsistent v14 spec. Skip with `DISPATCH_SKIP_GATE=1`
# only when intentionally bypassing the gate (e.g., scaffolding before tests
# exist).
if [[ "${DISPATCH_SKIP_GATE:-0}" != "1" ]]; then
  echo ">> pre-dispatch gate: pytest -m must_pass_before_dispatch"
  if ! (cd "${repo_root}" && .venv/bin/python -m pytest -m must_pass_before_dispatch -q); then
    echo ">> ABORT: pre-dispatch gate failed. Fix red tests or set DISPATCH_SKIP_GATE=1 to bypass intentionally." >&2
    exit 3
  fi
  echo ">> pre-dispatch gate GREEN"
fi

"${script_dir}/sync"

# Log every dispatch — a sweep is a loop that must be closed (pulled + analyzed).
ledger="${repo_root}/docs/experiments/dispatch_log.csv"
if [[ -f "${ledger}" ]]; then
  args_csv="${*//\"/\"\"}"
  printf '%s,%s,%s,%s,"%s",dispatched\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$(git rev-parse --abbrev-ref HEAD)" \
    "$(git rev-parse --short HEAD)" \
    "${submitter}" "${args_csv}" >> "${ledger}"
  echo ">> logged dispatch to docs/experiments/dispatch_log.csv (status=dispatched)"
fi

remote_args=()
for arg in "$@"; do
  remote_args+=("$(printf '%q' "${arg}")")
done

echo ">> ${DCC_HOST}: ROOT_DIR_BRAINTREEBANK=${DCC_ROOT_BT} EXCA_CACHE_FOLDER=${DCC_EXCA_CACHE} .venv/bin/python ${submitter} ${remote_args[*]:-}"
ssh -t "${DCC_HOST}" \
  "cd '${DCC_REPO}' && ROOT_DIR_BRAINTREEBANK='${DCC_ROOT_BT}' EXCA_CACHE_FOLDER='${DCC_EXCA_CACHE}' .venv/bin/python ${submitter} ${remote_args[*]:-}"

echo
echo ">> sweep dispatched. Close the loop: pull results, run the collector +"
echo ">> analysis, then set this run's docs/experiments/dispatch_log.csv row to 'analyzed'."
